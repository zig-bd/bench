.{
    .runs = 4,
    .warmup_runs = 1,
    .connections = 128,
    .threads = 2,
    .duration_s = 20,
    .closed = true,
    .rate = 0,
    .port = 8081,
    .timeout_s = 2,
    .frameworks = .{ "httpz", "zzz", "dusty-std", "dusty-zio", "std", "uwebzockets", "zinc" },
    .scenarios = .{
        .{
            .id = "plaintext",
            .label = "Plaintext",
            .description = "Minimal OK response - peak request throughput",
            .path = "/httpz",
            .method = "GET",
        },
        .{
            .id = "json",
            .label = "JSON",
            .description = "Serialize a small JSON user list",
            .path = "/api/users",
            .method = "GET",
        },
    },
}
